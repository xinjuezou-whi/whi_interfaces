#goal definition
geometry_msgs/PoseStamped target_pose
float64 velocity_scale
string controller_id
string goal_checker_id
string progress_checker_id
---
#result definition
# Error codes
# Note: The expected priority order of the errors should match the message order
uint16 NONE=0
uint16 UNKNOWN=100
uint16 INVALID_CONTROLLER=101
uint16 TF_ERROR=102
uint16 INVALID_PATH=103
uint16 PATIENCE_EXCEEDED=104
uint16 FAILED_TO_MAKE_PROGRESS=105
uint16 NO_VALID_CONTROL=106
uint16 CONTROLLER_TIMED_OUT=107

uint8 RES_SUCCEED=0
uint8 RES_FAILED=1
std_msgs/Empty result
uint16 error_code
string error_msg
---
#feedback
uint8 PROC_STANDBY=0
uint8 PROC_ACTING=1
uint8 feedback
